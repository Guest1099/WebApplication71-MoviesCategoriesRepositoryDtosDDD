@model GetMovieDto

 
<div class="db">
    <div style="height: 70px;">
        @Model.Title
    </div>

    @if (Model.PhotosMovie != null && Model.PhotosMovie.Any())
    {
        // wyświetlenie pierwszego zdjęcia
        if (Model.PhotosMovie[0].PhotoData.Length > 0)
        {
            var imageSource = $"data:image/png;base64,{Convert.ToBase64String(Model.PhotosMovie[0].PhotoData)}";
            <img src="@imageSource" style="width: 100%; height: 150px;" />
        }
    }

    <div class="df-sb">
        <div></div>
        <div>
            @Model.Category
        </div>
    </div>
    
    <div>
        @Html.Raw(Model.Description)
    </div>
</div>